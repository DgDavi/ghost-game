// Baseado em projects/09/Square/SquareGame.jack (www.nand2tetris.org)
// Adaptado para o Projeto 6 - Ghost Multiplayer.

/**
 * Jogo Ghost com dois jogadores.
 *
 * Jogador 1 (fantasma):  setas = direcao   |  '.' ou ';' = parar
 * Jogador 2 (pessoa):    w a s d = direcao |  'e' = parar
 * ESC (ou Q) encerra o jogo.
 *
 * Os dois personagens andam sozinhos ate encontrar uma parede, entao
 * cada jogador so precisa "tocar" na tecla de direcao.
 */
class GhostGame {
   field int direction; // direcao do fantasma: 0=parado, 1=cima, 2=baixo, 3=esq, 4=dir
   field Random random;
   field Ghost ghost;   // jogador 1
   field Person person; // jogador 2
   field GameMap map;

   /** Cria o mapa, o fantasma e a pessoa. */
   constructor GhostGame new() {
      let map = GameMap.new();
      do Screen.clearScreen();
      do map.draw();

      let ghost = Ghost.new(32, 48);
      let person = Person.new(448, 192);
      let random = Random.new(19);
      let direction = 0;
      return this;
   }

   /** Libera a memoria do jogo. */
   method void dispose() {
      do map.dispose();
      do ghost.dispose();
      do person.dispose();
      do Memory.deAlloc(this);
      return;
   }

   /** Move o fantasma uma celula na direcao atual; para se houver parede. */
   method void moveGhost() {
      var int col, row;
      var int nextCol, nextRow;

      if (direction = 0) {
         return;
      }

      let col = ghost.getX();
      let row = ghost.getY();
      let nextCol = col;
      let nextRow = row;

      if (direction = 1) { let nextRow = row - 1; }
      if (direction = 2) { let nextRow = row + 1; }
      if (direction = 3) { let nextCol = col - 1; }
      if (direction = 4) { let nextCol = col + 1; }

      // Colisao com parede: para o fantasma
      if (map.isWall(nextCol, nextRow)) {
         let direction = 0;
         return;
      }

      if (direction = 1) { do ghost.moveUp(); }
      if (direction = 2) { do ghost.moveDown(); }
      if (direction = 3) { do ghost.moveLeft(); }
      if (direction = 4) { do ghost.moveRight(); }
      return;
   }

   /** Le a tecla pressionada e atualiza a direcao do jogador correspondente. */
   method void handleKey(char key) {
      // ---- Jogador 1 (fantasma) ----
      if (key = 131) { let direction = 1; }   // seta cima
      if (key = 133) { let direction = 2; }   // seta baixo
      if (key = 130) { let direction = 3; }   // seta esquerda
      if (key = 132) { let direction = 4; }   // seta direita
      if ((key = 46) | (key = 59)) { let direction = 0; }   // '.' ou ';' = parar

      // ---- Jogador 2 (pessoa): aceita maiuscula e minuscula ----
      if ((key = 119) | (key = 87)) { do person.setDirection(1); }   // w
      if ((key = 115) | (key = 83)) { do person.setDirection(2); }   // s
      if ((key = 97)  | (key = 65)) { do person.setDirection(3); }   // a
      if ((key = 100) | (key = 68)) { do person.setDirection(4); }   // d
      if ((key = 101) | (key = 69)) { do person.stop(); }            // e = parar
      return;
   }

   /** Loop principal: a cada "frame" le o teclado e move os dois jogadores. */
   method void run() {
      var char key;
      var boolean exit;
      let exit = false;

      while (~exit) {
         let key = Keyboard.keyPressed();

         if ((key = 140) | (key = 81) | (key = 113)) { let exit = true; }  // ESC ou Q

         do handleKey(key);   // atualiza as direcoes
         do moveGhost();      // jogador 1 anda 1 celula (se puder)
         do person.update(map);   // jogador 2 anda 1 celula (se puder)

         do Sys.wait(80);     // controla a velocidade (menor = mais rapido)
      }
      return;
   }
}
