// Baseado em projects/09/PigDice/Random.jack (xctom/Nand2Tetris).
// Adaptado: o gerador original somava uma constante e usava so os bits mais
// baixos, o que gerava posicoes muito repetitivas. Agora usa um gerador
// congruencial linear de 16 bits.

/**
 * Random: gerador de numeros pseudo-aleatorios (o Jack nao tem um nativo).
 *
 * Formula: x = (25173 * x + 13849) mod 65536
 * (periodo completo: passa por todos os 65536 valores antes de repetir).
 * A semente vem do tempo que o jogador demora para apertar uma tecla na
 * tela inicial, entao cada partida comeca diferente.
 */
class Random {
   field int seed;        // estado atual do gerador
   field int calledTime;  // quantas vezes randRange foi chamado (depuracao)

   /** Cria o gerador com uma semente inicial. */
   constructor Random new(int seedIn) {
      let seed = seedIn;
      let seed = rand();   // embaralha a semente inicial
      return this;
   }

   /** Proximo numero pseudo-aleatorio no intervalo 0..32767. */
   method int rand() {
      let seed = (seed * 25173) + 13849;   // estouro de 16 bits faz o "mod 65536"
      return seed & 32767;                 // zera o bit de sinal
   }

   /** Numero pseudo-aleatorio no intervalo 0..range (inclusive). */
   method int randRange(int range) {
      var int r;

      let r = rand() / 8;   // descarta os 3 bits menos aleatorios
      return r - ((r / (range + 1)) * (range + 1));   // r mod (range + 1)
   }

   /** Libera a memoria do objeto. */
   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }
}
