/** Ponto de entrada: cria o jogo Ghost Multiplayer, executa e libera a memoria. */
class Main {
   function void main() {
      var GhostGame game;

      let game = GhostGame.new();
      do game.run();
      do game.dispose();

      return;
   }
}
